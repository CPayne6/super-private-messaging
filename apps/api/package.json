{
  "name": "@spm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@spm/protocol": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1"
  }
}
