# Copy to deploy/.env.production. This file is intentionally gitignored.
# Use long, randomly generated values for all passwords. URLs must use
# percent-encoding for reserved password characters.
POSTGRES_PASSWORD=replace-with-postgres-superuser-password
POSTGRES_MIGRATION_PASSWORD=replace-with-migration-password
POSTGRES_APP_PASSWORD=replace-with-app-password
DATABASE_URL=postgresql://spm_app:replace-with-url-encoded-app-password@postgres:5432/spm
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379
REDIS_PASSWORD=replace-with-redis-password
ALLOWED_ORIGINS=https://messaging.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
